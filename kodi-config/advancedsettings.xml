<?xml version="1.0" encoding="utf-8"?>
<!--
  Husham Play 1.1 advancedsettings.xml
  International defaults: no forced language/region/timezone (use system).
  Full reference: https://kodi.wiki/view/Advancedsettings.xml
-->
<advancedsettings>

  <loglevel>0</loglevel>

  <!-- Sensible network buffering for streaming on TV sticks and desktops -->
  <cache>
    <buffermode>1</buffermode>
    <memorysize>139460608</memorysize>
    <readfactor>4</readfactor>
  </cache>

  <videoplayer>
    <adjustrefreshrate>2</adjustrefreshrate>
    <synctype>1</synctype>
  </videoplayer>

  <videoextensions>
    <remove>.nfo</remove>
    <remove>.jpg</remove>
  </videoextensions>

</advancedsettings>
